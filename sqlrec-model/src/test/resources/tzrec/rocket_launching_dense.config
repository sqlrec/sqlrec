train_input_path: "/fixture/train.parquet"
model_dir: "/fixture/model"
train_config {
    sparse_optimizer {
        adagrad_optimizer {
            lr: 0.01
        }
        constant_learning_rate {
        }
    }
    dense_optimizer {
        adam_optimizer {
            lr: 0.01
        }
        constant_learning_rate {
        }
    }
    num_epochs: 1
    use_tensorboard: true
    tensorboard_summaries: "loss"
    tensorboard_summaries: "learning_rate"
    tensorboard_summaries: "global_gradient_norm"
    log_step_count_steps: 100
    save_checkpoints_steps: 1000
}
data_config {
    batch_size: 8
    dataset_type: ParquetDataset
    fg_mode: FG_NORMAL
    label_fields: "label"
    num_workers: 0
}
feature_configs {
    raw_feature {
        feature_name: "price"
        expression: "item:price"
        value_dim: 1
        default_value: "0"
    }
}
model_config {
    feature_groups {
        group_name: "deep"
        feature_names: "price"
        group_type: DEEP
    }
    rocket_launching {
        booster_mlp { hidden_units: [16,8] }
        light_mlp { hidden_units: [8,4] }
        feature_based_distillation: true
        feature_distillation_function: COSINE
    }
    num_class: 1
    losses { binary_cross_entropy {} }
    metrics { auc {} }
    metrics { normalized_entropy {} }
    metrics { accuracy {} }
    train_metrics { auc {} }
    train_metrics { accuracy {} }
}
