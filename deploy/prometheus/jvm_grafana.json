      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\",area=\"nonheap\"})",
          "legendFormat": "used",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\",area=\"nonheap\"})",
          "legendFormat": "committed",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heap utilization",
      "description": "Overall is total used / total maximum for instances with a defined maximum. Maximum shows the most utilized instance; values come from MemoryMXBean.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sqlrec_jvm_heap_used_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} and (sqlrec_jvm_heap_max_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} > 0)) / sum(sqlrec_jvm_heap_max_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} > 0)",
          "legendFormat": "overall",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "max(sqlrec_jvm_heap_used_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} / (sqlrec_jvm_heap_max_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} > 0))",
          "legendFormat": "maximum per instance",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heap maximum",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
