          "refId": "A",
          "expr": "sum(sqlrec_jvm_heap_max_bytes{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} > 0)",
          "legendFormat": "total",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
