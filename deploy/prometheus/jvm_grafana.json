    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU utilization",
      "description": "Unweighted average and maximum of reported MXBean utilization; not a cluster CPU-capacity ratio. System values may be shared by colocated instances. Container throttling requires infrastructure metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "drawStyle": "line",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(process_cpu_usage{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} >= 0)",
          "legendFormat": "process instance average",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "max(process_cpu_usage{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} >= 0)",
          "legendFormat": "process instance maximum",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "avg(system_cpu_usage{service=\"sqlrec\",namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",instance=~\"$instance\"} >= 0)",
          "legendFormat": "system instance average",
          "range": true,
          "instant": false,
          "interval": "15s",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "D",
