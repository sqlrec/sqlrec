<configuration>
    <property>
        <name>fs.permissions.umask-mode</name>
        <value>000</value>
    </property>
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>

    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>
    <!-- This development cluster has one DataNode. PyArrow defaults to three
         replicas, so appended TensorBoard files must not require a new node. -->
    <property>
        <name>dfs.client.block.write.replace-datanode-on-failure.policy</name>
        <value>NEVER</value>
    </property>
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>${HDFS_NAMENODE_DATA_DIR}</value>
    </property>
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>${HDFS_DATANODE_DATA_DIR}</value>
    </property>
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:${HDFS_NAMENODE_HTTP_PORT}</value>
    </property>
    <property>
        <name>dfs.datanode.address</name>
        <value>0.0.0.0:${HDFS_DATANODE_PORT}</value>
    </property>
    <property>
        <name>dfs.datanode.http.address</name>
        <value>0.0.0.0:${HDFS_DATANODE_HTTP_PORT}</value>
    </property>
</configuration>
