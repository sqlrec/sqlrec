{
  package: "com.sqlrec.sql.parser.impl",
  class: "SqlRecParserImpl",

  imports: [
    "com.sqlrec.sql.parser.*"
    "org.apache.calcite.sql.SqlAlienSystemTypeNameSpec"
    "org.apache.flink.sql.parser.ddl.SqlSet"
    "org.apache.flink.sql.parser.ddl.SqlUseDatabase"
    "org.apache.flink.sql.parser.dql.SqlShowTables"
    "java.util.ArrayList"
    "java.util.List"
  ]

  keywords: [
    "API"
    "APIS"
    "ASSERT"
    "ASYNC"
    "BYTES"
    "CACHE"
    "CHECKPOINT"
    "CHECKPOINTS"
    "EXPORT"
    "FLUSH"
    "FORMATTED"
    "FUNCTIONS"
    "GET_OR_DEFAULT"
    "IF"
    "MODEL"
    "MODELS"
    "SERVICE"
    "SERVICES"
    "STRING"
    "TABLES"
    "TIMEIN"
    "TRAIN"
    "USE"
  ]

  nonReservedKeywordsToAdd: [
    "IF"
    "TABLES"
    "USE"
  ]

  statementParserMethods: [
    "SqlDropSqlFunction()"
    "SqlDropApi()"
    "SqlCreateModel()"
    "SqlDropModel()"
    "SqlTrainModel()"
    "SqlExportModel()"
    "SqlCreateService()"
    "SqlDescribeStatement()"
    "SqlShowService()"
    "SqlDropService()"
    "SqlShowSqlFunction()"
    "SqlShowApi()"
    "SqlShowModel()"
    "SqlShowCheckpoint()"
    "SqlAlterModelDropCheckpoint()"
    "SqlDefineInputTable()"
    "SqlCallSqlFunction()"
    "SqlCache()"
    "SqlIfCache()"
    "SqlCreateResource()"
    "SqlReturn()"
    "SqlAssert()"
    "SqlFlush()"
    "SqlRecSet()"
    "SqlRecUseDefault()"
    "SqlRecShowTablesInDefault()"
  ]

  dataTypeParserMethods: [
    "SqlRecCollectionTypeName()"
    "SqlRecAliasTypeName()"
  ]

  implementationFiles: [
    "sqlRecIdentifier.ftl"
  ]
}
